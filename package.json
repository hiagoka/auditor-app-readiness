{
  "name": "auditor-app-readiness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditor de Prontidão para Publicação Mobile (iOS) — pipeline de agentes de IA que audita um projeto React Native/iOS antes do envio para a App Store.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit": "tsx cli.ts",
    "baseline": "tsx evaluation/run-baseline.ts",
    "eval": "tsx evaluation/run-solution.ts",
    "clone-repos": "bash scripts/clone-test-repos.sh",
    "fill-results": "tsx scripts/fill-results.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
